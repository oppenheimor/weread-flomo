# 本地 Java 后端开发配置。个人微信读书/flomo 凭证在登录后的账号设置中保存。
# 生成主密钥：node scripts/setup-encryption-key.ts。需安全备份，不能随意替换。
CREDENTIAL_ENCRYPTION_KEY=
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/weread_flomo
DATABASE_USERNAME=weread_flomo
DATABASE_PASSWORD=
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 使用 Vite 开发页面时，两处端口必须一致。
FRONTEND_PORT=5173
APP_PUBLIC_ORIGIN=http://127.0.0.1:5173
COOKIE_SECURE=false
# 若只访问 Java 打包页面，把 APP_PUBLIC_ORIGIN 改为 http://127.0.0.1:18081。
