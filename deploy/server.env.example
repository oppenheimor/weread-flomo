# 服务器配置示例。真实文件放 /srv/config/weread-flomo/service.env，权限 0600。
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/weread_flomo
DATABASE_USERNAME=weread_flomo
DATABASE_PASSWORD=
# 仅首次创建账号时使用；以后修改这些变量不会重置现有密码。
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 32 字节随机密钥的 Base64；个人 API 凭证在账号设置中填写，不在此配置。
# 主密钥需单独安全备份，不可随意更换，否则已存凭证无法解密。
CREDENTIAL_ENCRYPTION_KEY=
# 当前服务器 sparkden-services 网关；部署到其他环境必须重新核查地址。
BIND_ADDRESS=172.19.0.1
PORT=18081
SERVER_SERVLET_CONTEXT_PATH=/shimo
SERVER_SERVLET_SESSION_COOKIE_PATH=/shimo
# Origin 只包含协议/主机/端口，不包含 /shimo 路径。
APP_PUBLIC_ORIGIN=https://14.103.81.73
COOKIE_SECURE=true
SPRING_LIFECYCLE_TIMEOUT_PER_SHUTDOWN_PHASE=110s
# IP HTTPS 使用自签名证书。域名备案通过后另行确认切换，不自动恢复 DNS。
