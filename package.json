{
  "name": "weread-flomo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "cd backend && ./mvnw test",
    "test:postgres": "bash scripts/test-postgres.sh",
    "backend:dev": "cd backend && ./mvnw spring-boot:run -Dspring-boot.run.arguments=--spring.config.additional-location=optional:file:../.env[.properties]",
    "build:server": "npm run build && cd backend && ./mvnw clean package",
    "export:ledger": "node scripts/export-ledger.ts"
  },
  "dependencies": {
    "lucide-react": "^1.59.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
